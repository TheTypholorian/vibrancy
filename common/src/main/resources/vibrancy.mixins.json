{
  "required": true,
  "minVersion": "0.8",
  "package": "net.typho.vibrancy.mixin",
  "refmap": "${mod_id}.refmap.json",
  "compatibilityLevel": "JAVA_21",
  "mixins": [
    "LevelMixin",
    "OptionsMixin",
    "sodium.BlockRendererMixin",
    "sodium.ChunkVertexConsumerMixin",
    "sodium.ChunkVertexEncoderVertexMixin",
    "sodium.CompactChunkVertexMixin",
    "sodium.DefaultFluidRendererMixin"
  ],
  "client": [
    "ClientChunkCacheStorageMixin",
    "DebugScreenOverlayMixin",
    "GlDebugMixin",
    "GlStateManagerMixin",
    "KeyboardHandlerMixin",
    "LevelRendererMixin",
    "MainTargetMixin",
    "MinecraftMixin",
    "RenderTargetMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  }
}

