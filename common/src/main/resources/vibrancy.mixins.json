  "minVersion": "0.8",
  "package": "net.typho.vibrancy.mixin",
  "refmap": "${mod_id}.refmap.json",
  "compatibilityLevel": "JAVA_21",
  "mixins": [
    "ChunkMeshFormatsMixin",
    "ChunkVertexConsumerMixin",
    "ChunkVertexEncoderVertexMixin",
    "DefaultFluidRendererMixin",
    "LevelMixin",
    "OptionsMixin",
    "VertexConsumerTrackerMixin"
  ],
  "client": [
    "ClientChunkCacheStorageMixin",
    "DebugScreenOverlayMixin",
    "GlStateManagerMixin",
    "LevelRendererAccessor",
    "LevelRendererMixin",
    "MainTargetMixin",
    "MinecraftMixin",
    "RenderTargetMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  }
}

